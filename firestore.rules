rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && request.auth.token.role in ['secretary', 'admin'];
    }

    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}

